{
  "name": "revenue-products",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "revenue-products",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22.5"
      }
    },
    "node_modules/@jigglebox/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/agentfuse": {
      "resolved": "packages/agentfuse",
      "link": true
    },
    "node_modules/mcp-sentinel": {
      "resolved": "packages/mcp-sentinel",
      "link": true
    },
    "node_modules/recoverkit": {
      "resolved": "packages/recoverkit",
      "link": true
    },
    "node_modules/sentinel-cloud": {
      "resolved": "packages/sentinel-cloud",
      "link": true
    },
    "packages/agentfuse": {
      "version": "0.1.0",
      "dependencies": {
        "@jigglebox/shared": "*"
      },
      "bin": {
        "agentfuse": "src/server.js"
      }
    },
    "packages/mcp-sentinel": {
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "mcp-sentinel": "src/cli.js"
      }
    },
    "packages/recoverkit": {
      "version": "0.1.0",
      "dependencies": {
        "@jigglebox/shared": "*"
      }
    },
    "packages/sentinel-cloud": {
      "version": "0.1.0",
      "dependencies": {
        "@jigglebox/shared": "*",
        "mcp-sentinel": "*"
      }
    },
    "packages/shared": {
      "name": "@jigglebox/shared",
      "version": "0.1.0"
    }
  }
}
