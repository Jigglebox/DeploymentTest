{
  "name": "revenue-products",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "revenue-products",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22.5"
      }
    },
    "node_modules/@jigglebox/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/agentfuse": {
      "resolved": "packages/agentfuse",
      "link": true
    },
    "packages/agentfuse": {
      "version": "0.1.0",
      "dependencies": {
        "@jigglebox/shared": "*"
      },
      "bin": {
        "agentfuse": "src/server.js"
      }
    },
    "packages/shared": {
      "name": "@jigglebox/shared",
      "version": "0.1.0"
    }
  }
}
