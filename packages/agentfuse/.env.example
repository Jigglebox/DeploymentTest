PORT=8787
AGENTFUSE_ADMIN_TOKEN=change-me
AGENTFUSE_PUBLIC_URL=http://localhost:8787
AGENTFUSE_ALERT_WEBHOOK=
AGENTFUSE_PLAN=free
# Hosted multi-tenant mode: AGENTFUSE_MODE=hosted plus a 32-byte hex master key (openssl rand -hex 32)
AGENTFUSE_MODE=single
AGENTFUSE_MASTER_KEY=
# Hosts tenants may point a provider at (https only, * wildcards). Default: api.openai.com,api.anthropic.com,*.openai.azure.com
AGENTFUSE_ALLOWED_UPSTREAM_HOSTS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Self-serve upgrades (hosted): your own Stripe account
AGENTFUSE_STRIPE_SECRET_KEY=
AGENTFUSE_STRIPE_WEBHOOK_SECRET=
AGENTFUSE_PRO_PRICE_ID=
AGENTFUSE_TEAM_PRICE_ID=
# Operations loop: auto-filed GitHub issues for errors/feedback + daily digest
OPS_GITHUB_TOKEN=
OPS_GITHUB_REPO=Jigglebox/DeploymentTest
OPS_ALERT_WEBHOOK=
AGENTFUSE_ALERT_EMAIL=
RESEND_API_KEY=
AGENTFUSE_FROM_EMAIL=alerts@example.com
